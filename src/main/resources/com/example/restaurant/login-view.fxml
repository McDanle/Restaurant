<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="1000.0" prefWidth="1400.0" style="-fx-background-color: #fbeec1;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.restaurant.LoginPageController">

<children>
<VBox alignment="CENTER" layoutX="244.0" layoutY="39.0" prefHeight="900.0" prefWidth="818.0" spacing="15" style="-fx-background-color: #fff8e1; -fx-padding: 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10,0,0,5); -fx-background-radius: 15;" AnchorPane.bottomAnchor="150.0" AnchorPane.leftAnchor="400.0" AnchorPane.rightAnchor="400.0" AnchorPane.topAnchor="150.0">

    <children>
        <Label style="-fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 28px; -fx-text-fill: #4e342e;" text="Log-in" />

        <TextField fx:id="gmailField" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="40" prefWidth="400" promptText="Gmail" style="-fx-font-size: 14px; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #bcaaa4;">
               <font>
                  <Font name="Segoe UI Italic" size="12.0" />
               </font></TextField>

        <HBox alignment="CENTER_LEFT" maxWidth="-Infinity" prefHeight="40.0" prefWidth="460.0" spacing="5">
            <children>
                <StackPane alignment="CENTER_LEFT" prefHeight="40" prefWidth="398.0">
                    <children>
                        <PasswordField fx:id="passwordField" maxWidth="-Infinity" prefHeight="40" prefWidth="400" promptText="Password" style="-fx-font-size: 14px; -fx-background-radius: 12; -fx-border-radius: 12; -fx-border-color: #bcaaa4;" />
                        <TextField fx:id="visiblePasswordField" managed="false" prefHeight="40" prefWidth="400" promptText="Password" style="-fx-font-size: 14px; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #bcaaa4;" visible="false" />
                    </children>
                    <HBox.margin>
                        <Insets left="32.0" />
                    </HBox.margin>
                </StackPane>

                <ImageView fx:id="toggleEyeIcon" fitHeight="24" fitWidth="24" onMouseClicked="#togglePasswordVisibility" pickOnBounds="true" preserveRatio="true" style="-fx-cursor: hand;" />
            </children>
        </HBox>

        <Hyperlink onAction="#handleForgotPassword" style="-fx-text-fill: #8d6e63; -fx-font-size: 13px;" text="Forgot Password?" underline="true" />

        <Button fx:id="LoginButton" onAction="#handleDashBoard" prefHeight="45" prefWidth="300" style="-fx-background-color: #ff7043; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 25;" text="Log-in">
               <font>
                  <Font name="Segoe UI Bold" size="12.0" />
               </font></Button>

        <HBox alignment="CENTER" prefWidth="300" spacing="10">
            <children>
                <Line endX="100" startX="0" stroke="#ccc" strokeWidth="1" />
                <Label style="-fx-text-fill: #8d6e63; -fx-font-size: 16px;" text="Or" />
                <Line endX="100" startX="0" stroke="#ccc" strokeWidth="1" />
            </children>
        </HBox>

        <Button fx:id="SignUpButton" onAction="#handleSignUp2" prefHeight="45" prefWidth="300" style="-fx-background-color: transparent; -fx-border-color: #a1887f; -fx-text-fill: #8d6e63; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 25; -fx-border-radius: 25;" text="Create New Account" />

        <ProgressIndicator fx:id="loadingSpinner" prefHeight="30" prefWidth="30" visible="false" />
    </children>
</VBox>
</children>
        </AnchorPane>
