<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<AnchorPane prefHeight="1000.0" prefWidth="1400.0" style="-fx-background-color: #f0f2f5;" AnchorPane.leftAnchor="50.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.restaurant.LoginPageController">
    <children>
        <VBox alignment="CENTER" spacing="15" style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10,0,0,5);" AnchorPane.bottomAnchor="150.0" AnchorPane.leftAnchor="400.0" AnchorPane.rightAnchor="400.0" AnchorPane.topAnchor="150.0">
            <children>
                <Label style="-fx-font-family: 'Segoe UI Semibold'; -fx-font-size: 28px; -fx-text-fill: #333;" text="Log-in" />

                <TextField fx:id="gmailField" prefHeight="40" prefWidth="300" promptText="Gmail" style="-fx-font-size: 14px; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd;" />

                <PasswordField fx:id="passwordField" prefHeight="40" prefWidth="300" promptText="Password" style="-fx-font-size: 14px; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd;" />

                <Hyperlink onAction="#handleForgotPassword" style="-fx-text-fill: #0078d7; -fx-font-size: 13px;" text="Forgot Password?" />

                <Button fx:id="LoginButton" onAction="#handleDashBoard" prefHeight="45" prefWidth="300" style="-fx-background-color: #0078d7; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="Log-in" />

                <HBox alignment="CENTER" spacing="10">
                    <children>
                        <Line endX="100" startX="0" stroke="#aaa" strokeWidth="1" />
                        <Label style="-fx-text-fill: #666; -fx-font-size: 16px;" text="Or" />
                        <Line endX="100" startX="0" stroke="#aaa" strokeWidth="1" />
                    </children>
                </HBox>

                <Button fx:id="SignUpButton" onAction="#handleSignUp2" prefHeight="45" prefWidth="300" style="-fx-background-color: transparent; -fx-border-color: #0078d7; -fx-text-fill: #0078d7; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-radius: 8;" text="Create New Account" />

                <!-- Loading Spinner -->
                <ProgressIndicator fx:id="loadingSpinner" prefHeight="30" prefWidth="30" visible="false" />
            </children>
        </VBox>
    </children>
</AnchorPane>
