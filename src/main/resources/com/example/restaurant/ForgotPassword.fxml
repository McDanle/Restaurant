<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane fx:id="backToLogin" prefHeight="1000.0" prefWidth="1400.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.restaurant.ForgotPasswordController">

    <VBox alignment="CENTER" layoutX="495.0" layoutY="153.0" prefHeight="300.0" prefWidth="400.0" spacing="10.0" AnchorPane.bottomAnchor="80.0" AnchorPane.leftAnchor="480.0" AnchorPane.rightAnchor="480.0" AnchorPane.topAnchor="80.0">
        <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Forgot Password" />
        <TextField fx:id="gmailField" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="25.0" prefWidth="300" promptText="Enter Gmail" AnchorPane.leftAnchor="450.0" AnchorPane.rightAnchor="450.0">
         <font>
            <Font name="Segoe UI Italic" size="12.0" />
         </font></TextField>
        <PasswordField fx:id="newPasswordField" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="25.0" prefWidth="300" promptText="New Password">
         <font>
            <Font name="Segoe UI Italic" size="12.0" />
         </font></PasswordField>
        <PasswordField fx:id="confirmPasswordField" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="25.0" prefWidth="300" promptText="Confirm New Password">
         <font>
            <Font name="Segoe UI Italic" size="12.0" />
         </font></PasswordField>
        <Button onAction="#handleResetPassword" prefHeight="35.0" prefWidth="300" text="Reset Password">
         <font>
            <Font name="Segoe UI Bold" size="12.0" />
         </font></Button>
      <Button layoutX="10.0" layoutY="180.0" onAction="#handleBackToLogin" prefHeight="35.0" prefWidth="300" text="Back to Login">
         <font>
            <Font name="Segoe UI Bold" size="12.0" />
         </font></Button>
    </VBox>
</AnchorPane>
