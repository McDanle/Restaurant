<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane fx:id="backToLogin" prefHeight="1000.0" prefWidth="1400.0" style="-fx-background-color: #f0f2f5;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.restaurant.ForgotPasswordController">
    <children>
        <VBox alignment="CENTER" spacing="15" style="-fx-background-color: white; -fx-padding: 40; -fx-background-radius: 15; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10,0,0,5);" AnchorPane.bottomAnchor="150.0" AnchorPane.leftAnchor="400.0" AnchorPane.rightAnchor="400.0" AnchorPane.topAnchor="150.0">
            <children>
                <Label style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Forgot Password" />

                <TextField fx:id="gmailField" prefHeight="40" prefWidth="300" promptText="Enter Gmail" style="-fx-font-size: 14px; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd;" />

                <PasswordField fx:id="currentPasswordField" prefHeight="40" prefWidth="300" promptText="Enter Current Password" style="-fx-font-size: 14px; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd;" />

                <PasswordField fx:id="newPasswordField" prefHeight="40" prefWidth="300" promptText="New Password" style="-fx-font-size: 14px; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd;" />

                <PasswordField fx:id="confirmPasswordField" prefHeight="40" prefWidth="300" promptText="Confirm New Password" style="-fx-font-size: 14px; -fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #ddd;" />

                <Button onAction="#handleResetPassword" prefHeight="45" prefWidth="300" style="-fx-background-color: #0078d7; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8;" text="Reset Password" />

                <Button onAction="#handleBackToLogin" prefHeight="45" prefWidth="300" style="-fx-background-color: transparent; -fx-border-color: #0078d7; -fx-text-fill: #0078d7; -fx-font-weight: bold; -fx-background-radius: 8; -fx-border-radius: 8;" text="Back to Login" />
            </children>
        </VBox>
    </children>
</AnchorPane>
