<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" prefHeight="758.0" prefWidth="1006.0" spacing="20.0" style="-fx-background-color: #fefefe; -fx-padding: 20;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.restaurant.DrinkController">

    <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #333;" text="Our Refreshing Drinks" />

    <GridPane alignment="CENTER" hgap="20" prefHeight="331.0" prefWidth="903.0" style="-fx-padding: 10;" vgap="30">
        <columnConstraints>
            <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" maxWidth="359.0" minWidth="207.0" prefWidth="223.0" />
            <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" maxWidth="418.0" minWidth="227.0" prefWidth="227.0" />
            <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" maxWidth="433.0" minWidth="247.0" prefWidth="433.0" />
         <ColumnConstraints halignment="CENTER" hgrow="SOMETIMES" maxWidth="433.0" minWidth="247.0" prefWidth="433.0" />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints valignment="TOP" />
        </rowConstraints>

        <!-- Buko Juice -->
        <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefWidth="220" spacing="10" style="-fx-background-color: #ffffff; -fx-border-color: #cccccc; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 15;" GridPane.columnIndex="0">
            <ImageView fitHeight="100" fitWidth="150" preserveRatio="true">
                <image>
                    <Image url="@pictures/BukoJuice.png" />
                </image>
            </ImageView>
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Buko Juice" />
            <Label text="Naturally sweet coconut juice with soft strips." textAlignment="CENTER" wrapText="true" />
            <Label style="-fx-font-size: 14px; -fx-text-fill: #444;" text="₱10.00" />
            <HBox alignment="CENTER" spacing="5">
                <Button onAction="#decreaseBukoJuiceQuantity" prefWidth="30" text="−" />
                <Label fx:id="BukoJuiceQuantityLabel" alignment="CENTER" prefWidth="30" text="0" />
                <Button onAction="#increaseBukoJuiceQuantity" prefWidth="30" text="+" />
            </HBox>
            <Button fx:id="addBukoJuiceButton" onAction="#handleAddToCartBukoJuice" prefWidth="120" style="-fx-background-color: #28a745; -fx-text-fill: white;" text="Add to Cart" />
        </VBox>

        <!-- Coke -->
        <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="311.0" prefWidth="355.0" spacing="10" style="-fx-background-color: #ffffff; -fx-border-color: #cccccc; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 15;" GridPane.columnIndex="1">
            <ImageView fitHeight="100" fitWidth="150" preserveRatio="true">
                <image>
                    <Image url="@pictures/Coke.png" />
                </image>
            </ImageView>
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Coke" />
            <Label text="Classic fizzy Coca-Cola, ice-cold and refreshing." textAlignment="CENTER" wrapText="true" />
            <Label style="-fx-font-size: 14px; -fx-text-fill: #444;" text="₱20.00" />
            <HBox alignment="CENTER" spacing="5">
                <Button onAction="#decreaseCokeQuantity" prefWidth="30" text="−" />
                <Label fx:id="CokeQuantityLabel" alignment="CENTER" prefWidth="30" text="0" />
                <Button onAction="#increaseCokeQuantity" prefWidth="30" text="+" />
            </HBox>
            <Button fx:id="addCokeButton" onAction="#handleAddToCartCoke" prefWidth="120" style="-fx-background-color: #28a745; -fx-text-fill: white;" text="Add to Cart" />
        </VBox>

        <!-- Iced Tea -->
        <VBox alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="311.0" prefWidth="351.0" spacing="10" style="-fx-background-color: #ffffff; -fx-border-color: #cccccc; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 15;" GridPane.columnIndex="2">
            <ImageView fitHeight="100" fitWidth="150" preserveRatio="true">
                <image>
                    <Image url="@pictures/IcedTea.png" />
                </image>
            </ImageView>
            <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="Iced Tea" />
            <Label text="Lightly sweetened black tea over ice with lemon." textAlignment="CENTER" wrapText="true" />
            <Label style="-fx-font-size: 14px; -fx-text-fill: #444;" text="₱20.00" />
            <HBox alignment="CENTER" spacing="5">
                <Button onAction="#decreaseIcedTeaQuantity" prefWidth="30" text="−" />
                <Label fx:id="IcedTeaQuantityLabel" alignment="CENTER" prefWidth="30" text="0" />
                <Button onAction="#increaseIcedTeaQuantity" prefWidth="30" text="+" />
            </HBox>
            <Button fx:id="addIcedTeaButton" onAction="#handleAddToCartIcedTea" prefWidth="120" style="-fx-background-color: #28a745; -fx-text-fill: white;" text="Add to Cart" />
        </VBox>
    </GridPane>
</VBox>
