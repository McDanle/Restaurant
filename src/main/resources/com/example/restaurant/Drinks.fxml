<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" prefHeight="758.0" prefWidth="1006.0" spacing="15.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.restaurant.DrinkController">
    <Label style="-fx-font-size: 24px;" text="Drinks" />
    <GridPane hgap="3.0" prefHeight="709.0" prefWidth="992.0" vgap="10.0">
        <!-- Repeat for each dish -->
        <VBox alignment="CENTER" prefHeight="280.0" prefWidth="231.0" spacing="10.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
            <ImageView fitHeight="100" fitWidth="150" preserveRatio="true">
                <image>
                    <Image url="@pictures/BukoJuice.png" />
                </image></ImageView>
            <Label style="-fx-font-weight: bold;" text="Buko Juice">
                <font>
                    <Font size="14.0" />
                </font></Label>
            <Label prefHeight="34.0" prefWidth="206.0" text="Naturally sweet coconut juice with soft strips." wrapText="true" />
            <Label text="₱10.00" />
            <HBox alignment="CENTER" prefHeight="35.0" prefWidth="230.0">
                <Button onAction="#decreaseBukoJuiceQuantity" prefHeight="35.0" prefWidth="35.0" text="-" />
                <Label fx:id="BukoJuiceQuantityLabel" alignment="CENTER" prefHeight="35.0" prefWidth="35.0" text="0" />
                <Button onAction="#increaseBukoJuiceQuantity" prefHeight="35.0" prefWidth="35.0" text="+">
                    <HBox.margin>
                        <Insets right="5.0" />
                    </HBox.margin></Button>
                <Button fx:id="addBukoJuiceButton" onAction="#handleAddToCartBukoJuice" prefHeight="35.0" prefWidth="100.0" text="Add to Cart" />
            </HBox>
        </VBox>
        <VBox alignment="CENTER" layoutX="10.0" layoutY="10.0" prefHeight="276.0" prefWidth="230.0" spacing="10.0" GridPane.columnIndex="8">
            <children>
                <ImageView fitHeight="100.0" fitWidth="150" preserveRatio="true">
                    <image>
                        <Image url="@pictures/Coke.png" />
                    </image>
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
                </ImageView>
                <Label style="-fx-font-weight: bold;" text="Coke">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <Label prefHeight="34.0" prefWidth="206.0" text="Classic fizzy Coca-Cola, ice-cold and refreshing." wrapText="true" />
                <Label text="₱20.00">
                    <VBox.margin>
                        <Insets />
                    </VBox.margin></Label>
                <HBox alignment="CENTER" prefHeight="35.0" prefWidth="230.0">
                    <children>
                        <Button onAction="#decreaseCokeQuantity" prefHeight="35.0" prefWidth="35.0" text="-" />
                        <Label fx:id="CokeQuantityLabel" alignment="CENTER" prefHeight="35.0" prefWidth="35.0" text="0" />
                        <Button onAction="#increaseCokeQuantity" prefHeight="35.0" prefWidth="35.0" text="+">
                            <HBox.margin>
                                <Insets right="5.0" />
                            </HBox.margin>
                        </Button>
                        <Button fx:id="addCokeButton" onAction="#handleAddToCartCoke" prefHeight="35.0" prefWidth="100.0" text="Add to Cart" />
                    </children>
                </HBox>
            </children>
        </VBox>
        <VBox alignment="CENTER" layoutX="264.0" layoutY="10.0" prefHeight="280.0" prefWidth="230.0" spacing="10.0" GridPane.columnIndex="9">
            <children>
                <ImageView fitHeight="100" fitWidth="150" preserveRatio="true">
                    <image>
                        <Image url="@pictures/IcedTea.png" />
                    </image>
                </ImageView>
                <Label style="-fx-font-weight: bold;" text="Iced Tea">
                    <font>
                        <Font size="14.0" />
                    </font>
                </Label>
                <Label prefHeight="34.0" prefWidth="206.0" text="Lightly sweetened black tea over ice with lemon." wrapText="true" />
                <Label text="₱20.00" />
                <HBox alignment="CENTER" prefHeight="35.0" prefWidth="230.0">
                    <children>
                        <Button onAction="#decreaseIcedTeaQuantity" prefHeight="35.0" prefWidth="35.0" text="-" />
                        <Label fx:id="IcedTeaQuantityLabel" alignment="CENTER" prefHeight="35.0" prefWidth="35.0" text="0" />
                        <Button onAction="#increaseIcedTeaQuantity" prefHeight="35.0" prefWidth="35.0" text="+">
                            <HBox.margin>
                                <Insets right="5.0" />
                            </HBox.margin>
                        </Button>
                        <Button fx:id="addIcedTeaButton" onAction="#handleAddToCartIcedTea" prefHeight="35.0" prefWidth="100.0" text="Add to Cart" />
                    </children>
                </HBox>
            </children>
        </VBox>
        <columnConstraints>
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints maxWidth="0.0" minWidth="0.0" prefWidth="0.0" />
            <ColumnConstraints maxWidth="0.0" minWidth="0.0" prefWidth="0.0" />
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints />
            <ColumnConstraints maxWidth="0.0" minWidth="0.0" prefWidth="0.0" />
            <ColumnConstraints maxWidth="230.0" minWidth="230.0" prefWidth="230.0" />
            <ColumnConstraints />
        </columnConstraints>
        <rowConstraints>
            <RowConstraints />
            <RowConstraints />
            <RowConstraints />
        </rowConstraints>
        <!-- Add more GridPane items with different column/row indexes -->
    </GridPane>
</VBox>
