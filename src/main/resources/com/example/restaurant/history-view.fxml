<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<AnchorPane prefWidth="1920.0" prefHeight="1080.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.restaurant.historyController">
    <children>
        <VBox alignment="TOP_CENTER" spacing="20" layoutX="50" layoutY="50" prefWidth="800" prefHeight="1000" AnchorPane.topAnchor="50.0" AnchorPane.leftAnchor="50.0">
            <children>
                <Label text="Order History" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
                <ListView fx:id="historyListView" prefHeight="900.0" prefWidth="800.0"/>
            </children>
        </VBox>
    </children>
</AnchorPane>
