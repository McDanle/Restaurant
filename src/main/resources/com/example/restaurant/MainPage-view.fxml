<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="1000.0" prefWidth="1400.0" style="-fx-background-color: #fbeec1;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.restaurant.MainController">

<children>
<VBox alignment="CENTER" layoutX="150.0" layoutY="25.0" prefHeight="350.0" prefWidth="400.0" style="-fx-background-color: #fff8e1; -fx-background-radius: 20; -fx-padding: 40; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 8, 0, 0, 4);" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

    <children>
        <Label alignment="CENTER" prefHeight="63.0" prefWidth="264.0" text="Welcome to TastyTap" textAlignment="CENTER">
            <font>
                <Font name="Nirmala UI Bold" size="24.0" />
            </font>
        </Label>

        <Button fx:id="SignUpButton" mnemonicParsing="false" onAction="#handleSignUpPage" prefHeight="50.0" prefWidth="400.0" style="-fx-background-color: #ff7043; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 25;">
            <text>Create Account</text>
               <font>
                  <Font name="Segoe UI Bold" size="12.0" />
               </font>
        </Button>

        <Button fx:id="LoginButton" mnemonicParsing="false" onAction="#handleLoginPage" prefHeight="50.0" prefWidth="400.0" style="-fx-background-color: #8d6e63; -fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold; -fx-background-radius: 25;">
            <VBox.margin>
                <Insets top="20.0" />
            </VBox.margin>
            <text>Log-in</text>
        </Button>
    </children>
</VBox>
</children>
        </AnchorPane>
