<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="customerBorderPane" prefHeight="1000.0" prefWidth="1400.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.restaurant.DashBoardController">

   <!-- ========== TOP BAR ========== -->
   <top>
      <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #2C3E50; -fx-padding: 15;">
         <children>
            <Label style="-fx-text-fill: white; -fx-font-size: 22px; -fx-font-weight: bold;" text="TastyTap Restaurant" />
            <Pane HBox.hgrow="ALWAYS" />
            <Button onAction="#handleHistory" prefWidth="100" style="-fx-font-size: 14px;" text="History" />
            <Button onAction="#handleProfile" prefWidth="100" style="-fx-font-size: 14px;" text="Profile" />
         </children>
      </HBox>
   </top>

   <!-- ========== LEFT MENU PANEL ========== -->
   <left>
      <VBox alignment="TOP_CENTER" spacing="20" style="-fx-background-color: #ECF0F1; -fx-padding: 30;">
         <Label style="-fx-font-size: 28px; -fx-font-weight: bold;" text="Menu" />
         <Button onAction="#handleMainCourse" prefWidth="150" style="-fx-font-size: 14px;" text="Main Course" />
         <Button onAction="#handleDrinks" prefWidth="150" style="-fx-font-size: 14px;" text="Drinks" />
      </VBox>
   </left>

   <!-- ========== CENTER MENU ITEMS ========== -->
   <center>
      <ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-padding: 20;">
         <content>
            <AnchorPane>
               <VBox fx:id="menuItemsContainer" spacing="20" style="-fx-padding: 20;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
            </AnchorPane>
         </content>
      </ScrollPane>
   </center>

   <!-- ========== RIGHT CART PANEL ========== -->
   <right>
      <VBox alignment="TOP_CENTER" spacing="15" style="-fx-background-color: #F8F9FA; -fx-padding: 25;">
         <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Your Cart" />

         <TableView fx:id="cartTable" prefHeight="400.0" prefWidth="320.0">
            <columns>
               <TableColumn fx:id="itemNameColumn" prefWidth="100" text="Item" />
               <TableColumn fx:id="itemPriceColumn" prefWidth="70" text="Price" />
               <TableColumn fx:id="quantityColumn" prefWidth="50" text="Qty" />
               <TableColumn fx:id="totalColumn" prefWidth="80" text="Total" />
            </columns>
         </TableView>

         <Label fx:id="totalPriceLabel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #27AE60;" text="Total Price: ₱0.00" />

         <HBox alignment="CENTER" spacing="10">
            <Button onAction="#removeSelectedItem" prefWidth="130" text="Remove" />
            <Button onAction="#clearCart" prefWidth="130" text="Clear" />
         </HBox>

         <!-- PAYMENT COMBOBOX -->
         <ComboBox fx:id="paymentMethodComboBox" onAction="#handlePaymentMethodChange" prefHeight="45" prefWidth="280" promptText="Select Payment Method" />

         <!-- GCASH PAYMENT CARD -->
         <VBox fx:id="gcashDetailsBox" managed="false" spacing="10" style="-fx-padding: 15; -fx-border-color: #bdc3c7; -fx-border-radius: 10; -fx-background-color: #ffffff; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);" visible="false">
            <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="GCash Payment Details" />
            <TextField fx:id="gcashNumberField" prefHeight="40" prefWidth="280" promptText="Enter GCash Mobile Number" />
            <TextField fx:id="gcashReferenceField" prefHeight="40" prefWidth="280" promptText="Enter GCash Reference Number" />
            <Label style="-fx-font-size: 12px; -fx-text-fill: #e67e22;" text="※ Send payment first and enter the correct reference number." wrapText="true" />
         </VBox>

         <!-- CHECKOUT BUTTON -->
         <Button onAction="#checkout" prefHeight="50" prefWidth="280" style="-fx-background-color: #27AE60; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;" text="Check Out" />
      </VBox>
   </right>
</BorderPane>
