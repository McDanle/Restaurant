<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane fx:id="customerBorderPane" prefHeight="1000.0" prefWidth="1400.0" style="-fx-background-color: #fbeec1;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.restaurant.DashBoardController">

   <top>
      <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-background-color: #6d4c41; -fx-padding: 15; -fx-background-radius: 0 0 10 10;">
         <children>
            <Label style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" text="TastyTap Restaurant" />
            <Pane HBox.hgrow="ALWAYS" />
            <Button onAction="#handleHistory" prefWidth="100" style="-fx-font-size: 14px; -fx-background-color: #d7ccc8; -fx-background-radius: 8;" text="History" />
            <Button onAction="#handleProfile" prefWidth="100" style="-fx-font-size: 14px; -fx-background-color: #d7ccc8; -fx-background-radius: 8;" text="Profile" />
         </children>
      </HBox>
   </top>

   <left>
      <VBox alignment="TOP_CENTER" spacing="20" style="-fx-background-color: #fff8e1; -fx-padding: 30; -fx-background-radius: 0 10 10 0;">
         <Label style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #6d4c41;" text="Menu" />
         <Button onAction="#handleMainCourse" prefWidth="150" style="-fx-font-size: 14px; -fx-background-color: #ffe0b2; -fx-background-radius: 10;" text="Foods" />
         <Button onAction="#handleDrinks" prefWidth="150" style="-fx-font-size: 14px; -fx-background-color: #ffe0b2; -fx-background-radius: 10;" text="Drinks" />
      </VBox>
   </left>

   <center>
      <ScrollPane fitToHeight="true" fitToWidth="true" style="-fx-padding: 20;">
         <content>
            <AnchorPane>
               <VBox fx:id="menuItemsContainer" spacing="20" style="-fx-padding: 20;" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0" />
            </AnchorPane>
         </content>
      </ScrollPane>
   </center>

   <right>
      <VBox alignment="TOP_CENTER" spacing="15" style="-fx-background-color: #fff8e1; -fx-padding: 25; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10,0,0,5);">
         <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #6d4c41;" text="Your Cart" />

         <TableView fx:id="cartTable" prefHeight="400.0" prefWidth="320.0" style="-fx-background-radius: 10; -fx-border-color: #d7ccc8;">
            <columns>
               <TableColumn fx:id="itemNameColumn" prefWidth="100" text="Item" />
               <TableColumn fx:id="itemPriceColumn" prefWidth="70" text="Price" />
               <TableColumn fx:id="quantityColumn" prefWidth="50" text="Qty" />
               <TableColumn fx:id="totalColumn" prefWidth="80" text="Total" />
            </columns>
         </TableView>

         <Label fx:id="totalPriceLabel" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #27AE60;" text="Total Price: ₱0.00" />

         <HBox alignment="CENTER" spacing="10">
            <Button onAction="#removeSelectedItem" prefWidth="130" style="-fx-background-color: #ffe0b2; -fx-background-radius: 10;" text="Remove" />
            <Button onAction="#clearCart" prefWidth="130" style="-fx-background-color: #ffe0b2; -fx-background-radius: 10;" text="Clear" />
         </HBox>

         <ComboBox fx:id="paymentMethodComboBox" onAction="#handlePaymentMethodChange" prefHeight="45" prefWidth="280" promptText="Select Payment Method" style="-fx-background-radius: 10;" />

         <VBox fx:id="gcashDetailsBox" managed="false" spacing="10" style="-fx-padding: 15; -fx-border-color: #d7ccc8; -fx-border-radius: 10; -fx-background-color: #ffffff; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 0);" visible="false">
            <Label style="-fx-font-size: 14px; -fx-font-weight: bold;" text="GCash Payment Details" />
            <TextField fx:id="gcashNumberField" prefHeight="40" prefWidth="280" promptText="Enter GCash Mobile Number" style="-fx-background-radius: 10; -fx-border-color: #d7ccc8;" />
            <TextField fx:id="gcashReferenceField" prefHeight="40" prefWidth="280" promptText="Enter GCash Reference Number" style="-fx-background-radius: 10; -fx-border-color: #d7ccc8;" />
            <Label style="-fx-font-size: 12px; -fx-text-fill: #e67e22;" text="※ Send payment first and enter the correct reference number." wrapText="true" />
         </VBox>

         <Button onAction="#checkout" prefHeight="50" prefWidth="280" style="-fx-background-color: #ff7043; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px; -fx-background-radius: 25;" text="Check Out" />
      </VBox>
   </right>
</BorderPane>
