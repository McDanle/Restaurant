<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<VBox alignment="TOP_CENTER" prefHeight="700.0" prefWidth="1000.0" spacing="30" style="-fx-background-color: #fff8e1; -fx-padding: 40 50 40 50;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.restaurant.ProfileController">

    <!-- Title -->
    <Label style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #6d4c41;" text="Profile Page" />

    <!-- Profile Image Section -->
    <VBox alignment="CENTER" spacing="10">
            <ImageView fx:id="profileImageView" fitHeight="120" fitWidth="120" pickOnBounds="true" preserveRatio="true" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 5);">
                <clip>
                    <Circle fx:id="clipCircle" />
                </clip>
            </ImageView>


        <Button fx:id="uploadImageButton" onAction="#handleUploadImage" style="-fx-font-size: 14px; -fx-background-color: #d7ccc8; -fx-text-fill: #6d4c41; -fx-background-radius: 5;" text="Upload Photo" />
    </VBox>

    <VBox alignment="CENTER_LEFT" maxWidth="600" spacing="15">

        <HBox alignment="CENTER_LEFT" spacing="2.0">
            <Label maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="25.0" prefWidth="51.0" style="-fx-font-weight: bold; -fx-text-fill: #6d4c41; -fx-font-size: 16px;" text="Name:" />
            <Label fx:id="nameLabel" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="25.0" prefWidth="225.0" style="-fx-text-fill: #6d4c41; -fx-font-size: 16px;" />
            <TextField fx:id="editNameField" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="35.0" prefWidth="300.0" style="-fx-font-size: 16px;" visible="false" />
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label prefHeight="25.0" prefWidth="50.0" style="-fx-font-weight: bold; -fx-text-fill: #6d4c41; -fx-font-size: 16px;" text="Email:" />
            <Label fx:id="gmailLabel" prefHeight="25.0" prefWidth="300.0" style="-fx-text-fill: #6d4c41; -fx-font-size: 16px;" />
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label minHeight="-Infinity" minWidth="-Infinity" prefHeight="25.0" prefWidth="58.0" style="-fx-font-weight: bold; -fx-text-fill: #6d4c41; -fx-font-size: 16px;" text="Phone:" />
            <Label fx:id="phoneLabel" prefHeight="25.0" prefWidth="400.0" style="-fx-text-fill: #6d4c41; -fx-font-size: 16px;" />
            <TextField fx:id="editPhoneField" prefHeight="35.0" prefWidth="400.0" style="-fx-font-size: 16px;" visible="false" />
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label minHeight="-Infinity" minWidth="-Infinity" prefHeight="25.0" prefWidth="68.0" style="-fx-font-weight: bold; -fx-text-fill: #6d4c41; -fx-font-size: 16px;" text="Address:" />
            <Label fx:id="addressLabel" prefHeight="25.0" prefWidth="400.0" style="-fx-text-fill: #6d4c41; -fx-font-size: 16px;" />
            <TextField fx:id="editAddressField" prefHeight="35.0" prefWidth="400.0" style="-fx-font-size: 16px;" visible="false" />
        </HBox>

    </VBox>

    <!-- Buttons Section -->
    <HBox alignment="CENTER" spacing="20">
        <Button fx:id="editButton" onAction="#handleEditProfile" style="-fx-background-color: #ff7043; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Edit Profile" />

        <Button fx:id="saveButton" onAction="#handleSaveChanges" style="-fx-background-color: #ffe0b2; -fx-text-fill: #6d4c41; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Save Changes" visible="false" />

        <Button fx:id="changePasswordButton" onAction="#handleChangePassword" style="-fx-background-color: #ff7043; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Change Password" />

        <Button fx:id="logoutButton" onAction="#handleLogout" style="-fx-background-color: #ff7043; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Logout" />
    </HBox>

</VBox>
