<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<VBox alignment="TOP_CENTER" prefHeight="700.0" prefWidth="1000.0" spacing="30" style="-fx-background-color: #fff8e1; -fx-padding: 40 50 40 50;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.restaurant.ProfileController">

    <Label style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #6d4c41;" text="Profile Page" />

    <VBox alignment="CENTER" spacing="10">
        <ImageView fx:id="profileImageView" fitHeight="120" fitWidth="120" pickOnBounds="true" preserveRatio="true" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 10, 0, 0, 5);">
            <clip>
                <Circle fx:id="clipCircle" />
            </clip>
        </ImageView>
        <Button fx:id="uploadImageButton" onAction="#handleUploadImage" style="-fx-font-size: 14px; -fx-background-color: #d7ccc8; -fx-text-fill: #6d4c41; -fx-background-radius: 5;" text="Upload Photo" />
    </VBox>

    <VBox alignment="CENTER_LEFT" maxWidth="600" spacing="15">

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label style="-fx-font-weight: bold; -fx-text-fill: #6d4c41; -fx-font-size: 16px;" text="Name:" />
            <Label fx:id="nameLabel" style="-fx-text-fill: #6d4c41; -fx-font-size: 16px;" />
            <TextField fx:id="editNameField" style="-fx-font-size: 16px;" visible="false" />
            <Button fx:id="editNameButton" onAction="#handleEditName" style="-fx-font-size: 12px; -fx-background-color: #ff7043; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="Edit">
            <HBox.margin>
               <Insets left="163.0" />
            </HBox.margin></Button>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label style="-fx-font-weight: bold; -fx-text-fill: #6d4c41; -fx-font-size: 16px;" text="Email:" />
            <Label fx:id="gmailLabel" style="-fx-text-fill: #6d4c41; -fx-font-size: 16px;" />
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label style="-fx-font-weight: bold; -fx-text-fill: #6d4c41; -fx-font-size: 16px;" text="Phone:" />
            <Label fx:id="phoneLabel" style="-fx-text-fill: #6d4c41; -fx-font-size: 16px;" />
            <TextField fx:id="editPhoneField" style="-fx-font-size: 16px;" visible="false" />
            <Button fx:id="editPhoneButton" onAction="#handleEditPhone" style="-fx-font-size: 12px; -fx-background-color: #ff7043; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="Edit">
            <HBox.margin>
               <Insets left="162.0" />
            </HBox.margin></Button>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <Label style="-fx-font-weight: bold; -fx-text-fill: #6d4c41; -fx-font-size: 16px;" text="Address:" />
            <Label fx:id="addressLabel" style="-fx-text-fill: #6d4c41; -fx-font-size: 16px;" />
            <TextField fx:id="editAddressField" style="-fx-font-size: 16px;" visible="false" />
            <Button fx:id="editAddressButton" onAction="#handleEditAddress" style="-fx-font-size: 12px; -fx-background-color: #ff7043; -fx-text-fill: white; -fx-background-radius: 5; -fx-cursor: hand;" text="Edit">
            <HBox.margin>
               <Insets left="150.0" />
            </HBox.margin></Button>
        </HBox>

    </VBox>


    <HBox alignment="CENTER" spacing="20">
        <Button fx:id="saveButton" onAction="#handleSaveChanges" style="-fx-background-color: #ffe0b2; -fx-text-fill: #6d4c41; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Save Changes" visible="false" />
        <Button fx:id="changePasswordButton" onAction="#handleChangePassword" style="-fx-background-color: #ff7043; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Change Password" />
        <Button fx:id="logoutButton" onAction="#handleLogout" style="-fx-background-color: #ff7043; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 5; -fx-cursor: hand;" text="Logout" />
    </HBox>


</VBox>
