<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="TOP_CENTER" prefHeight="700.0" prefWidth="1000.0" spacing="30" style="-fx-background-color: #f4f6f8; -fx-padding: 40 50 40 50;" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.restaurant.ProfileController">

    <Label style="-fx-font-size: 30px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Profile Page" />

    <!-- Profile Image -->
    <VBox alignment="CENTER" spacing="10">
        <ImageView fx:id="profileImageView" fitHeight="120" fitWidth="120" pickOnBounds="true" preserveRatio="true" style="-fx-effect: dropshadow(gaussian, rgba(0,0,0,0.3), 10, 0.5, 0, 0); -fx-background-radius: 60;" />
        <Button fx:id="uploadImageButton" onAction="#handleUploadImage" style="-fx-font-size: 14px; -fx-background-color: #8e44ad; -fx-text-fill: white;" text="Upload Photo" />
    </VBox>

    <!-- Profile Information -->
    <VBox alignment="CENTER_LEFT" prefWidth="400" spacing="15">

        <Label style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;" text="Account Information" />

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #34495e;" text="Name:" />
            <Label fx:id="nameLabel" style="-fx-font-size: 18px; -fx-text-fill: #34495e;" text="-" />
            <TextField fx:id="editNameField" prefWidth="250" style="-fx-font-size: 18px;" visible="false" />
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #34495e;" text="Gmail:" />
            <Label fx:id="gmailLabel" style="-fx-font-size: 18px; -fx-text-fill: #34495e;" text="-" />
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #34495e;" text="Phone:" />
            <Label fx:id="phoneLabel" style="-fx-font-size: 18px; -fx-text-fill: #34495e;" text="-" />
            <TextField fx:id="editPhoneField" prefWidth="250" style="-fx-font-size: 18px;" visible="false" />
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #34495e;" text="Address:" />
            <Label fx:id="addressLabel" style="-fx-font-size: 18px; -fx-text-fill: #34495e;" text="-" />
            <TextField fx:id="editAddressField" prefWidth="250" style="-fx-font-size: 18px;" visible="false" />
        </HBox>
    </VBox>

    <!-- Buttons Section -->
    <VBox alignment="CENTER" spacing="15">
        <HBox alignment="CENTER" spacing="20">
            <Button fx:id="editButton" onAction="#handleEditProfile" prefWidth="150" style="-fx-font-size: 16px; -fx-background-color: #2980b9; -fx-text-fill: white; -fx-padding: 8 0; -fx-background-radius: 5;" text="Edit Profile" />
            <Button fx:id="saveButton" onAction="#handleSaveChanges" prefWidth="150" style="-fx-font-size: 16px; -fx-background-color: #27ae60; -fx-text-fill: white; -fx-padding: 8 0; -fx-background-radius: 5;" text="Save Changes" visible="false" />
        </HBox>

        <Button fx:id="changePasswordButton" onAction="#handleChangePassword" prefWidth="320" style="-fx-font-size: 14px; -fx-background-color: #f39c12; -fx-text-fill: white; -fx-padding: 10 0; -fx-background-radius: 5;" text="Change Password" />

        <Button onAction="#handleLogout" prefWidth="320" style="-fx-font-size: 16px; -fx-background-color: #c0392b; -fx-text-fill: white; -fx-padding: 10 0; -fx-background-radius: 5;" text="Logout" />
    </VBox>

</VBox>
